<?xml version="1.0" encoding="UTF-8"?>
<definitions name="GeometriaService"
  targetNamespace="http://example.com/geometria"
  xmlns="http://schemas.xmlsoap.org/wsdl/"
  xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
  xmlns:tns="http://example.com/geometria"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <types>
    <xsd:schema elementFormDefault="qualified" targetNamespace="http://example.com/geometria">
      <xsd:element name="AreaRectangulo">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="base" type="xsd:double"/>
            <xsd:element name="altura" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="AreaRectanguloResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="area" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="PerimetroRectangulo">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="base" type="xsd:double"/>
            <xsd:element name="altura" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
      <xsd:element name="PerimetroRectanguloResponse">
        <xsd:complexType>
          <xsd:sequence>
            <xsd:element name="perimetro" type="xsd:double"/>
          </xsd:sequence>
        </xsd:complexType>
      </xsd:element>
    </xsd:schema>
  </types>

  <message name="AreaRectanguloIn">
    <part name="parameters" element="tns:AreaRectangulo"/>
  </message>
  <message name="AreaRectanguloOut">
    <part name="parameters" element="tns:AreaRectanguloResponse"/>
  </message>
  <message name="PerimetroRectanguloIn">
    <part name="parameters" element="tns:PerimetroRectangulo"/>
  </message>
  <message name="PerimetroRectanguloOut">
    <part name="parameters" element="tns:PerimetroRectanguloResponse"/>
  </message>

  <portType name="GeometriaPortType">
    <operation name="AreaRectangulo">
      <input message="tns:AreaRectanguloIn"/>
      <output message="tns:AreaRectanguloOut"/>
    </operation>
    <operation name="PerimetroRectangulo">
      <input message="tns:PerimetroRectanguloIn"/>
      <output message="tns:PerimetroRectanguloOut"/>
    </operation>
  </portType>

  <binding name="GeometriaBinding" type="tns:GeometriaPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <operation name="AreaRectangulo">
      <soap:operation soapAction="http://example.com/geometria/AreaRectangulo"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
    <operation name="PerimetroRectangulo">
      <soap:operation soapAction="http://example.com/geometria/PerimetroRectangulo"/>
      <input><soap:body use="literal"/></input>
      <output><soap:body use="literal"/></output>
    </operation>
  </binding>

  <service name="GeometriaService">
    <port name="GeometriaPort" binding="tns:GeometriaBinding">
      <soap:address location="http://localhost:3000/soap/geometria"/>
    </port>
  </service>
</definitions>